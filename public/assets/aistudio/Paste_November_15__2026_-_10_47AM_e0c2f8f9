      tab.addEventListener('click', function() {
        tabs.forEach(t => {
          t.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          t.classList.add('text-on-surface-variant', 'bg-surface-container-lowest');
          const dot = t.querySelector('span.w-1\\.5');
          if (dot) dot.remove();
