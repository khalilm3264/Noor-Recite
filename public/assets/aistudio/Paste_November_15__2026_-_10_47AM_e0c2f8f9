<script>
(function() {
  // Web Audio Synth context
  let audioCtx = null;
  function getAudioCtx() {
    if (!audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) {
        audioCtx = new AudioContext();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playHarmonicTone(freq, durationMs) {
    try {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc1 = ctx.createOscillator();
      const osc2 = ctx.createOscillator();
      const gain = ctx.createGain();

      osc1.type = 'sine';
      osc1.frequency.setValueAtTime(freq, ctx.currentTime);

      osc2.type = 'triangle';
      osc2.frequency.setValueAtTime(freq * 1.5, ctx.currentTime);

      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.18, ctx.currentTime + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + (durationMs / 1000));

      osc1.connect(gain);
      osc2.connect(gain);
      gain.connect(ctx.destination);

      osc1.start();
      osc2.start();
      osc1.stop(ctx.currentTime + (durationMs / 1000));
      osc2.stop(ctx.currentTime + (durationMs / 1000));
    } catch(e) {
      console.warn("Audio Context playback err", e);
    }
  }

  // App State
  let currentWordIdx = 3;
  let isPlayingAyah = false;
  let ayahSequenceTimer = null;
  let playbackRate = 0.75;
  let isAbLoopActive = true;
  let isVoiceRecording = false;

  const wordCards = Array.from(document.querySelectorAll('.word-card'));
  const btnPlayAyah = document.getElementById('btn-play-ayah');
  const iconPlayAyah = document.getElementById('icon-play-ayah');
  const btnStreamPlay = document.getElementById('btn-stream-play');
  const iconStreamPlay = document.getElementById('icon-stream-play');
  const btnPrevWord = document.getElementById('btn-prev-word');
  const btnNextWord = document.getElementById('btn-next-word');
  const btnVoiceMatch = document.getElementById('btn-voice-match');
  const micIcon = document.getElementById('mic-icon');
  const voiceMatchText = document.getElementById('voice-match-text');
  const voiceTargetBadge = document.getElementById('voice-target-badge');
  const voiceResultBox = document.getElementById('voice-result-box');
  const voiceScore = document.getElementById('voice-score');
  const btnCloseResult = document.getElementById('btn-close-result');
  const voiceHelperText = document.getElementById('voice-helper-text');
  const cadenceTimerText = document.getElementById('cadence-timer-text');
  const cadenceBars = document.getElementById('cadence-bars')?.querySelectorAll('div') || [];
  const stripWords = Array.from(document.querySelectorAll('.ayah-strip-word'));
  const speedButtons = Array.from(document.querySelectorAll('.speed-btn'));
  const btnToggleAb = document.getElementById('btn-toggle-ab');
  const iconAb = document.getElementById('icon-ab');
  const labelAb = document.getElementById('label-ab');
  const btnResetLoop = document.getElementById('btn-reset-loop');
  const headerStatus = document.getElementById('header-status');
  const headerPulse = document.getElementById('header-pulse');

  // Activate a word visually
  function setActiveWord(index, autoScroll = false) {
    currentWordIdx = index;
    voiceTargetBadge.textContent = 'Word ' + index;

    wordCards.forEach(card => {
      const idx = parseInt(card.dataset.wordIdx);
      const isTarget = (idx === index);
      const accentBar = card.querySelector('.active-accent-bar');
      const idxPill = card.querySelector('.word-idx-pill');
      const playBtn = card.querySelector('.word-play-btn');
      const playIcon = card.querySelector('.word-play-icon');
      const arabicText = card.querySelector('.arabic-word-text');

      if (isTarget) {
        card.classList.add('card-glow-active', 'bg-gradient-to-br', 'from-surface-container', 'via-surface-container-lowest', 'to-surface-container-low', 'shadow-md');
        if (accentBar) accentBar.classList.remove('hidden');
        if (idxPill) {
          idxPill.className = 'word-idx-pill w-6 h-6 rounded-full bg-secondary-container text-on-secondary font-label-sm text-label-sm font-bold flex items-center justify-center shadow-xs';
        }
        if (playBtn) {
          playBtn.className = 'word-play-btn flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary text-on-primary shadow-sm transition-all';
          if (playIcon) playIcon.className = 'material-symbols-outlined text-[16px] animate-spin word-play-icon';
        }
        if (arabicText) {
          arabicText.classList.add('arabic-glow');
        }
        if (autoScroll) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } else {
        card.classList.remove('card-glow-active', 'bg-gradient-to-br', 'from-surface-container', 'via-surface-container-lowest', 'to-surface-container-low', 'shadow-md');
        if (accentBar) accentBar.classList.add('hidden');
        if (idxPill) {
          idxPill.className = 'word-idx-pill w-6 h-6 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm font-bold flex items-center justify-center';
        }
        if (playBtn) {
          playBtn.className = 'word-play-btn flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high hover:bg-surface-container-highest text-primary transition-all';
          if (playIcon) playIcon.className = 'material-symbols-outlined text-[16px] word-play-icon';
        }
        if (arabicText) {
          arabicText.classList.remove('arabic-glow');
        }
      }
    });

    // Update Header Ayah Arabic highlight strip
    stripWords.forEach(sw => {
      const swIdx = parseInt(sw.dataset.wordIndex);
      if (swIdx === index) {
        sw.className = 'ayah-strip-word transition-colors px-1 rounded cursor-pointer text-secondary font-extrabold bg-secondary/10';
      } else {
        sw.className = 'ayah-strip-word transition-colors px-1 rounded cursor-pointer text-primary';
      }
    });

    // Sound feedback for the word
    const activeCard = wordCards.find(c => parseInt(c.dataset.wordIdx) === index);
    if (activeCard) {
      const freq = parseFloat(activeCard.dataset.freq) || 300;
      const duration = (parseFloat(activeCard.dataset.duration) || 1000) / playbackRate;
      playHarmonicTone(freq, duration);
      animateCadenceWaveform(duration);
    }
  }

  // Waveform Bar Animation
  function animateCadenceWaveform(durationMs) {
    if (!cadenceBars || !cadenceBars.length) return;
    cadenceBars.forEach((bar, i) => {
      bar.classList.add('animate-sound-bar');
      bar.style.animationDelay = (i * 0.08) + 's';
    });
    setTimeout(() => {
      cadenceBars.forEach(bar => {
        bar.classList.remove('animate-sound-bar');
      });
    }, durationMs);
  }

  // Attach card click handlers
  wordCards.forEach(card => {
    card.addEventListener('click', (e) => {
      const idx = parseInt(card.dataset.wordIdx);
      if (isPlayingAyah) stopAyahPlayback();
      setActiveWord(idx, false);
      if (headerStatus) headerStatus.textContent = 'Word ' + idx + ': ' + card.dataset.trans;
    });
  });

  // Top strip word clicks
  stripWords.forEach(sw => {
    sw.addEventListener('click', () => {
      const idx = parseInt(sw.dataset.wordIndex);
      if (isPlayingAyah) stopAyahPlayback();
      setActiveWord(idx, true);
    });
  });

  // Play Ayah sequence
  function startAyahPlayback() {
    isPlayingAyah = true;
    if (iconPlayAyah) iconPlayAyah.textContent = 'pause';
    if (iconStreamPlay) iconStreamPlay.textContent = 'pause';
    if (headerStatus) headerStatus.textContent = 'Playing Ayah 1...';
    if (headerPulse) headerPulse.classList.add('animate-ping');

    let currentStep = isAbLoopActive ? 3 : 1;
    const maxStep = 4;
    const minStep = isAbLoopActive ? 3 : 1;

    function step() {
      if (!isPlayingAyah) return;
      setActiveWord(currentStep, true);

      const activeCard = wordCards.find(c => parseInt(c.dataset.wordIdx) === currentStep);
      const rawDur = activeCard ? parseFloat(activeCard.dataset.duration) : 1000;
      const stepDuration = rawDur / playbackRate;

      // Update timer display
      if (cadenceTimerText) {
        cadenceTimerText.textContent = (stepDuration / 1000).toFixed(1) + 's Playing';
      }

      currentStep++;
      if (currentStep > maxStep) {
        if (isAbLoopActive) {
          currentStep = minStep; // Loop A-B
        } else {
          // Finished Ayah
          ayahSequenceTimer = setTimeout(() => {
            stopAyahPlayback();
            if (cadenceTimerText) cadenceTimerText.textContent = '4.9s Total';
            if (headerStatus) headerStatus.textContent = 'Ayah Complete';
          }, stepDuration);
          return;
        }
      }

      ayahSequenceTimer = setTimeout(step, stepDuration + 120);
    }

    step();
  }

  function stopAyahPlayback() {
    isPlayingAyah = false;
    if (ayahSequenceTimer) clearTimeout(ayahSequenceTimer);
    if (iconPlayAyah) iconPlayAyah.textContent = 'play_arrow';
    if (iconStreamPlay) iconStreamPlay.textContent = 'stream';
    if (headerStatus) headerStatus.textContent = 'Word By Word';
    if (headerPulse) headerPulse.classList.remove('animate-ping');
    if (cadenceTimerText) cadenceTimerText.textContent = '4.9s Total';
  }

  function toggleAyahPlay() {
    if (isPlayingAyah) {
      stopAyahPlayback();
    } else {
      startAyahPlayback();
    }
  }

  btnPlayAyah?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleAyahPlay();
  });

  btnStreamPlay?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleAyahPlay();
  });

  // Next / Prev controls
  btnPrevWord?.addEventListener('click', () => {
    if (isPlayingAyah) stopAyahPlayback();
    let prev = currentWordIdx - 1;
    if (prev < 1) prev = 4;
    setActiveWord(prev, true);
  });

  btnNextWord?.addEventListener('click', () => {
    if (isPlayingAyah) stopAyahPlayback();
    let next = currentWordIdx + 1;
    if (next > 4) next = 1;
    setActiveWord(next, true);
  });

  // Speed controls
  speedButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      speedButtons.forEach(b => {
        b.className = 'speed-btn px-2 py-0.5 rounded-md text-on-surface-variant font-label-sm text-label-sm hover:text-primary transition-all';
      });
      btn.className = 'speed-btn px-2 py-0.5 rounded-md bg-primary text-on-primary font-label-sm text-label-sm font-bold shadow-xs transition-all';
      playbackRate = parseFloat(btn.dataset.speed) || 1.0;
      
      const bpmBadge = document.getElementById('bpm-badge');
      if (bpmBadge) {
        bpmBadge.textContent = (0.94 * playbackRate).toFixed(2) + 'x BPM';
      }
      playHarmonicTone(440, 100);
    });
  });

  // A-B Looper button
  btnToggleAb?.addEventListener('click', () => {
    isAbLoopActive = !isAbLoopActive;
    if (isAbLoopActive) {
      btnToggleAb.className = 'px-2.5 py-1 rounded-lg bg-primary-container text-on-primary font-label-sm text-label-sm font-semibold flex items-center gap-1 shadow-xs transition-colors hover:brightness-110 active:scale-95';
      if (iconAb) iconAb.textContent = 'repeat_on';
      if (labelAb) labelAb.textContent = 'A-B Word 3-4';
    } else {
      btnToggleAb.className = 'px-2.5 py-1 rounded-lg bg-surface-container text-on-surface-variant hover:text-primary font-label-sm text-label-sm font-medium flex items-center gap-1 transition-colors active:scale-95';
      if (iconAb) iconAb.textContent = 'repeat';
      if (labelAb) labelAb.textContent = 'Loop Full';
    }
  });

  btnResetLoop?.addEventListener('click', () => {
    if (isPlayingAyah) stopAyahPlayback();
    setActiveWord(1, true);
    if (voiceResultBox) voiceResultBox.classList.add('hidden');
  });

  // Voice Match Simulation
  btnVoiceMatch?.addEventListener('click', () => {
    if (isVoiceRecording) return;
    isVoiceRecording = true;

    if (isPlayingAyah) stopAyahPlayback();

    // Visual feedback: recording countdown
    btnVoiceMatch.classList.add('recording-pulse', 'bg-red-600', 'text-white');
    if (micIcon) micIcon.textContent = 'fiber_manual_record';
    if (voiceMatchText) voiceMatchText.textContent = 'Listening (3s)...';
    if (voiceHelperText) voiceHelperText.textContent = 'Recite now with clear Tajweed & tartil cadence...';
    
    // Play warm cue tone
    playHarmonicTone(520, 200);

    let count = 3;
    const interval = setInterval(() => {
      count--;
      if (count > 0) {
        if (voiceMatchText) voiceMatchText.textContent = `Listening (${count}s)...`;
        playHarmonicTone(520 + (3 - count) * 40, 100);
      } else {
        clearInterval(interval);
        finishVoiceMatch();
      }
    }, 1000);
  });

  function finishVoiceMatch() {
    isVoiceRecording = false;
    btnVoiceMatch.classList.remove('recording-pulse', 'bg-red-600', 'text-white');
    btnVoiceMatch.classList.add('bg-secondary-container', 'text-on-secondary');
    if (micIcon) micIcon.textContent = 'mic';
    if (voiceMatchText) voiceMatchText.textContent = 'Voice Match Test';

    // Play success chime
    setTimeout(() => playHarmonicTone(660, 200), 50);
    setTimeout(() => playHarmonicTone(880, 400), 200);

    // Random accuracy between 92% and 97%
    const score = Math.floor(Math.random() * 6) + 92;
    if (voiceScore) voiceScore.textContent = score + '%';

    if (voiceResultBox) {
      voiceResultBox.classList.remove('hidden');
      voiceResultBox.classList.add('flex');
    }
    if (voiceHelperText) {
      voiceHelperText.textContent = `Match recorded! Pacing & articulation matched Saad Al-Ghamdi.`;
    }

    // Boost progress bar
    const progressFill = document.getElementById('progress-bar-fill');
    const progressValText = document.getElementById('progress-val-text');
    if (progressFill && progressValText) {
      progressFill.style.width = '88%';
      progressValText.textContent = '88%';
    }
  }

  btnCloseResult?.addEventListener('click', () => {
    if (voiceResultBox) {
      voiceResultBox.classList.add('hidden');
      voiceResultBox.classList.remove('flex');
    }
  });

  // Study Navigation tabs interaction
