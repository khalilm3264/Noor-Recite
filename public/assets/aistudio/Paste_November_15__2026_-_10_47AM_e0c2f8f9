        this.classList.remove('text-on-surface-variant', 'bg-surface-container-lowest');
        this.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
        
        const dot = document.createElement('span');
        dot.className = 'w-1.5 h-1.5 rounded-full bg-secondary-container';
        this.prepend(dot);
      });
    });

    // Play/Pause toggler on mini player
    const miniPlayBtn = document.getElementById('mini-play-btn');
    if (miniPlayBtn) {
      miniPlayBtn.addEventListener('click', function() {
        const icon = this.querySelector('.material-symbols-outlined');
        if (icon.textContent.trim() === 'pause') {
          icon.textContent = 'play_arrow';
        } else {
          icon.textContent = 'pause';
        }
      });
    }

    // Featured Tartil click handler
    const featuredBtn = document.getElementById('play-featured-btn');
    if (featuredBtn) {
      featuredBtn.addEventListener('click', function() {
        if (miniPlayBtn) {
          const icon = miniPlayBtn.querySelector('.material-symbols-outlined');
          icon.textContent = 'pause';
        }
      });
    }

    // Search filter micro-interaction
    const searchInput = document.getElementById('surah-search-input');
    const cards = document.querySelectorAll('.surah-card');
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        cards.forEach(card => {
          const text = card.textContent.toLowerCase();
          if (text.includes(query)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  })();
