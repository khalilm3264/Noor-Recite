        if (isPlaying) {
          playIcon.textContent = 'pause';
          playBtn.classList.remove('opacity-90');
        } else {
          playIcon.textContent = 'play_arrow';
          playBtn.classList.add('opacity-90');
        }
      });
    }

    // Speed toggle cyclical state
    const speedBtn = document.getElementById('btn-speed-toggle');
    const speeds = ['1.0x', '0.75x', '1.25x', '1.5x'];
    let currentSpeedIndex = 0;

    if (speedBtn) {
      speedBtn.addEventListener('click', function() {
        currentSpeedIndex = (currentSpeedIndex + 1) % speeds.length;
        speedBtn.textContent = speeds[currentSpeedIndex];
      });
    }

    // Tafsir drawer toggle
    const toggleTafsirBtn = document.getElementById('toggle-tafsir');
    const sheetTafsirBtn = document.getElementById('btn-tafsir-sheet');
    const tafsirDrawer = document.getElementById('tafsir-drawer');
    const closeTafsirBtn = document.getElementById('close-tafsir');

    function openTafsir() {
      if (tafsirDrawer) {
