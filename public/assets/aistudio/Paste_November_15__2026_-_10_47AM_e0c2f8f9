<script>
  // Simple micro-interactions for waveform toggle and playhead tracking feedback
  (function() {
    const playSheikhBtn = document.getElementById('btn-play-sheikh');
    const playUserBtn = document.getElementById('btn-play-user');
    const scrubLine = document.getElementById('scrub-line');
    const scrubDot = document.getElementById('scrub-dot');
    let isPlaying = false;
    let animFrame;
    let progress = 285;

    function animatePlayhead() {
      if (!isPlaying) return;
      progress += 1.2;
      if (progress > 490) progress = 20;
      if (scrubLine && scrubDot) {
        scrubLine.setAttribute('x1', progress);
        scrubLine.setAttribute('x2', progress);
        scrubDot.setAttribute('cx', progress);
      }
      animFrame = requestAnimationFrame(animatePlayhead);
    }

    if (playSheikhBtn) {
      playSheikhBtn.addEventListener('click', function() {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playSheikhBtn.classList.add('ring-2', 'ring-secondary-container');
          cancelAnimationFrame(animFrame);
          animatePlayhead();
        } else {
          playSheikhBtn.classList.remove('ring-2', 'ring-secondary-container');
          cancelAnimationFrame(animFrame);
        }
      });
    }

    if (playUserBtn) {
      playUserBtn.addEventListener('click', function() {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playUserBtn.classList.add('ring-2', 'ring-primary-container');
          cancelAnimationFrame(animFrame);
          animatePlayhead();
        } else {
          playUserBtn.classList.remove('ring-2', 'ring-primary-container');
          cancelAnimationFrame(animFrame);
        }
      });
    }

    const recordBtn = document.getElementById('btn-record-again');
    if (recordBtn) {
      recordBtn.addEventListener('click', function() {
        const originalText = recordBtn.innerHTML;
        recordBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[22px]">progress_activity</span><span>Listening to your Tajweed...</span>';
        recordBtn.classList.add('bg-secondary-container', 'text-on-secondary-container');
        setTimeout(() => {
          recordBtn.innerHTML = originalText;
          recordBtn.classList.remove('bg-secondary-container', 'text-on-secondary-container');
        }, 2200);
      });
    }
  })();
