<!-- INTERACTIVE CLIENT-SIDE LOGIC -->
<script>
  (function initHifzQuiz() {
    let selectedOption = null;
    let isAnswerChecked = false;
    let audioPromptPlaying = false;
    let voiceRecording = false;

    // Web Audio API Synthesizer for delightful micro-feedback
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playTone(freq, duration, type = 'sine') {
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {
        // audio fallback
      }
    }

    function playSuccessChime() {
      playTone(523.25, 0.15); // C5
      setTimeout(() => playTone(659.25, 0.15), 90); // E5
      setTimeout(() => playTone(783.99, 0.3), 180); // G5
    }

    function playSelectTap() {
      playTone(440, 0.06, 'triangle');
    }

    // Elements
    const optionButtons = document.querySelectorAll('.quiz-option-btn');
    const submitBtn = document.getElementById('submit-btn');
    const submitBtnText = document.getElementById('submit-btn-text');
    const skipBtn = document.getElementById('skip-btn');
    const targetBlankPill = document.getElementById('target-blank-pill');
    const targetBlankText = document.getElementById('target-blank-text');
    const blankTranslit = document.getElementById('blank-translit-text');
    const blankTranslation = document.getElementById('blank-translation-text');
    const feedbackBanner = document.getElementById('feedback-banner');
    const feedbackTitle = document.getElementById('feedback-status-title');
    const feedbackExp = document.getElementById('feedback-explanation');
    const playAudioPromptBtn = document.getElementById('play-audio-prompt');
    const promptPlayIcon = document.getElementById('prompt-play-icon');
    const voiceRecordBtn = document.getElementById('voice-record-btn');
    const voiceWaveform = document.getElementById('voice-waveform-panel');
    const voiceRecordText = document.getElementById('voice-record-text');
    const speedBtn = document.getElementById('speed-toggle-btn');
    const hintBtn = document.getElementById('hint-audio-btn');

    // Option Selection
    optionButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (isAnswerChecked) return;

        playSelectTap();

        optionButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
          b.classList.add('bg-surface-container-lowest');
          const badge = b.querySelector('.option-badge');
          if (badge) {
            badge.classList.remove('bg-secondary-container', 'text-on-secondary-container');
            badge.classList.add('bg-surface-container', 'text-primary');
          }
        });

        // Activate clicked option
        btn.classList.remove('bg-surface-container-lowest');
        btn.classList.add('bg-surface-container-high', 'shadow-md');
        const activeBadge = btn.querySelector('.option-badge');
        if (activeBadge) {
          activeBadge.classList.remove('bg-surface-container', 'text-primary');
          activeBadge.classList.add('bg-secondary-container', 'text-on-secondary-container');
        }

        selectedOption = btn;
        submitBtn.removeAttribute('disabled');

        // Fill in the blank preview temporarily
        const chosenArabic = btn.getAttribute('data-arabic');
        const chosenTranslit = btn.getAttribute('data-translit');
        const chosenMeaning = btn.getAttribute('data-meaning');

        targetBlankText.classList.remove('text-secondary', 'animate-pulse');
        targetBlankText.classList.add('text-primary');
        targetBlankText.textContent = chosenArabic;
        blankTranslit.textContent = chosenTranslit;
        blankTranslation.textContent = chosenMeaning;
      });
    });

    // Check Answer
    submitBtn.addEventListener('click', () => {
      if (!isAnswerChecked) {
        if (!selectedOption) return;
        const isCorrect = selectedOption.getAttribute('data-correct') === 'true';

        isAnswerChecked = true;
        feedbackBanner.classList.remove('hidden');

        if (isCorrect) {
          playSuccessChime();
          targetBlankPill.classList.remove('bg-secondary-fixed/50');
          targetBlankPill.classList.add('bg-primary-container', 'text-on-primary', 'shadow-lg');
          targetBlankText.classList.remove('text-primary');
          targetBlankText.classList.add('text-on-primary');

          selectedOption.classList.remove('bg-surface-container-high');
          selectedOption.classList.add('bg-primary', 'text-on-primary');

          feedbackTitle.innerHTML = `
            <span class="material-symbols-outlined text-[24px] text-primary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
            <span class="font-headline-md text-headline-md text-primary font-bold">Masha'Allah! Mumtaz</span>
          `;
          feedbackExp.textContent = "You correctly completed Ayah 2 with proper tajweed madd. Next drill Ayah 3 awaits!";
          submitBtnText.textContent = "Continue to Ayah 3";
        } else {
          playTone(220, 0.3, 'sawtooth');
          targetBlankPill.classList.add('bg-error-container', 'text-on-error-container');
          targetBlankText.textContent = "الْعَالَمِينَ"; // correct answer revealed
          feedbackTitle.innerHTML = `
            <span class="material-symbols-outlined text-[24px] text-error" style="font-variation-settings: 'FILL' 1;">error</span>
            <span class="font-headline-md text-headline-md text-error font-bold">Revise Word</span>
          `;
          feedbackExp.textContent = "Ayah 2 concludes with 'al-ʿālamīn'. We have rescheduled this ayah for immediate re-test.";
          submitBtnText.textContent = "Try Again";
        }
      } else {
        // Reset or progress to next question
        isAnswerChecked = false;
        feedbackBanner.classList.add('hidden');
        submitBtnText.textContent = "Check Recall";
        submitBtn.setAttribute('disabled', 'true');
        targetBlankText.textContent = "? ؟ ؟";
        targetBlankText.className = "text-secondary animate-pulse text-[20px] font-bold tracking-widest font-headline-md";
        targetBlankPill.className = "inline-flex items-center justify-center align-middle mx-2 px-3 py-1 min-w-[110px] h-[46px] rounded-xl bg-secondary-fixed/50 text-secondary font-quran-display-mobile text-quran-display-mobile font-bold shadow-sm transition-all duration-300";
        blankTranslit.textContent = "[ ... ]";
        blankTranslation.textContent = "[ ... ]";

        optionButtons.forEach(b => {
          b.className = "quiz-option-btn group w-full text-left p-3.5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-all flex items-center justify-between active:scale-[0.99]";
        });
        selectedOption = null;
      }
    });

    // Skip Button Handler
    skipBtn.addEventListener('click', () => {
      playTone(330, 0.1);
      targetBlankText.textContent = "الْعَالَمِينَ";
      targetBlankText.classList.remove('animate-pulse');
      blankTranslit.textContent = "al-ʿālamīn";
      blankTranslation.textContent = "the worlds";
      feedbackBanner.classList.remove('hidden');
      feedbackTitle.innerHTML = `
        <span class="material-symbols-outlined text-[22px] text-secondary">info</span>
        <span class="font-headline-md text-headline-md text-secondary font-bold">Ayah Solution Revealed</span>
      `;
      feedbackExp.textContent = "Word revealed. Listen to Sheikh Saad Al-Ghamdi once more to anchor memory.";
      submitBtnText.textContent = "Next Ayah";
      submitBtn.removeAttribute('disabled');
      isAnswerChecked = true;
    });

    // Audio Prompt Toggle Playback Simulation
    let waveInterval;
    playAudioPromptBtn.addEventListener('click', () => {
      audioPromptPlaying = !audioPromptPlaying;
      if (audioPromptPlaying) {
        promptPlayIcon.textContent = 'pause';
        playTone(350, 0.15);
        const eqBars = document.querySelectorAll('#audio-wave-container span');
        waveInterval = setInterval(() => {
          eqBars.forEach(b => {
            const h = Math.floor(Math.random() * 20) + 4;
            b.style.height = `${h}px`;
          });
        }, 120);
      } else {
        promptPlayIcon.textContent = 'play_arrow';
        clearInterval(waveInterval);
      }
    });

    // Speed Pill Toggle
    let currentSpeed = 1.0;
    speedBtn.addEventListener('click', () => {
      currentSpeed = currentSpeed === 1.0 ? 0.75 : currentSpeed === 0.75 ? 1.25 : 1.0;
      speedBtn.textContent = `${currentSpeed}x`;
      playSelectTap();
    });

    // Voice Drill Toggle
    voiceRecordBtn.addEventListener('click', () => {
      voiceRecording = !voiceRecording;
      if (voiceRecording) {
        playTone(600, 0.1);
        voiceWaveform.classList.remove('hidden');
        voiceWaveform.classList.add('flex');
        voiceRecordText.textContent = "Reciting... (Release when done)";
        voiceRecordBtn.classList.replace('bg-primary', 'bg-secondary');
      } else {
        playTone(400, 0.1);
        voiceWaveform.classList.add('hidden');
        voiceWaveform.classList.remove('flex');
        voiceRecordText.textContent = "Hold or Tap to Recite Word";
        voiceRecordBtn.classList.replace('bg-secondary', 'bg-primary');

        // Automatically trigger option A as recognized
        optionButtons[0].click();
      }
    });

    // Tajweed Lightbulb Hint
    hintBtn.addEventListener('click', () => {
      playTone(580, 0.15);
      alert("Tajweed Hint: The word begins with Hamzat al-Wasl followed by Lām Qamariyyah (الْـ) and concludes with Madd 'Arid Lissukoon.");
