<script>
    (function initThematicHub() {
      // Toggle study drawer in featured topic card
      const drawerBtn = document.getElementById('toggleAyahDrawerBtn');
      const drawer = document.getElementById('ayahDrawer');
      const drawerChevron = document.getElementById('drawerChevron');
      const drawerBtnLabel = document.getElementById('drawerBtnLabel');

      if (drawerBtn && drawer) {
        drawerBtn.addEventListener('click', () => {
          const isClosed = drawer.classList.contains('hidden');
          if (isClosed) {
            drawer.classList.remove('hidden');
            drawerChevron.style.transform = 'rotate(180deg)';
            drawerBtnLabel.textContent = 'Hide Tajweed';
          } else {
            drawer.classList.add('hidden');
            drawerChevron.style.transform = 'rotate(0deg)';
            drawerBtnLabel.textContent = 'Study Ayah';
          }
        });
      }

      // Quick play toggle for Featured audio snippet
      const playBtn = document.getElementById('playFeaturedAudioBtn');
      const playIcon = document.getElementById('playFeaturedAudioIcon');
      const progressBar = document.getElementById('audioProgressBar');
      let isPlaying = false;
      let progressInterval;

      if (playBtn && playIcon) {
        playBtn.addEventListener('click', () => {
          isPlaying = !isPlaying;
          if (isPlaying) {
            playIcon.textContent = 'pause';
            let width = 40;
            progressInterval = setInterval(() => {
              width = width >= 100 ? 10 : width + 3;
              if (progressBar) progressBar.style.width = width + '%';
            }, 300);
          } else {
            playIcon.textContent = 'play_arrow';
            clearInterval(progressInterval);
          }
        });
      }

      // Bookmark active state toggle
      const bookmarkBtn = document.getElementById('featuredBookmarkBtn');
      const bookmarkIcon = document.getElementById('featuredBookmarkIcon');
      let bookmarked = false;
      if (bookmarkBtn && bookmarkIcon) {
        bookmarkBtn.addEventListener('click', () => {
          bookmarked = !bookmarked;
          bookmarkIcon.textContent = bookmarked ? 'bookmark' : 'bookmark_border';
          bookmarkBtn.classList.toggle('text-secondary', bookmarked);
          bookmarkBtn.classList.toggle('text-on-surface-variant', !bookmarked);
        });
      }

      // Filter pills switching
      const pills = document.querySelectorAll('.filter-pill');
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-primary', 'text-on-primary');
            p.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
          });
          pill.classList.add('bg-primary', 'text-on-primary');
          pill.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
        });
      });
    })();
  </script>
