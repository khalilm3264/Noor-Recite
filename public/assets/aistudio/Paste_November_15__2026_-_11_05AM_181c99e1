<script>
  let isPlaying = false;
  let isShuffled = false;
  let isAutoplay = true;
  let sortOptions = ['Surah Sequence', 'Revelation Order', 'Most Listened'];
  let sortIndex = 0;

  function togglePlayState() {
    isPlaying = !isPlaying;
    const icon = document.getElementById('playIconSpan');
    const masterBtn = document.getElementById('masterPlayBtn');
    
    if (isPlaying) {
      icon.textContent = 'pause';
      masterBtn.classList.remove('bg-secondary-container');
      masterBtn.classList.add('bg-primary');
      masterBtn.classList.add('text-on-primary');
    } else {
      icon.textContent = 'play_arrow';
      masterBtn.classList.remove('bg-primary');
      masterBtn.classList.remove('text-on-primary');
      masterBtn.classList.add('bg-secondary-container');
    }
  }

  function toggleTopicBookmark() {
    const icon = document.getElementById('topicBookmarkIcon');
    const btn = document.getElementById('bookmarkTopicBtn');
    if (icon.textContent === 'bookmark_add') {
      icon.textContent = 'bookmark_added';
      btn.classList.add('text-secondary');
    } else {
      icon.textContent = 'bookmark_add';
      btn.classList.remove('text-secondary');
    }
  }

  function toggleCardBookmark(button) {
    const icon = button.querySelector('.material-symbols-outlined');
    if (icon.textContent === 'bookmark') {
      icon.textContent = 'bookmark_border';
      button.classList.remove('text-secondary');
      button.classList.add('text-on-surface-variant');
      icon.style.fontVariationSettings = "'FILL' 0";
    } else {
      icon.textContent = 'bookmark';
      button.classList.remove('text-on-surface-variant');
      button.classList.add('text-secondary');
      icon.style.fontVariationSettings = "'FILL' 1";
    }
  }

  function toggleShuffle() {
    isShuffled = !isShuffled;
    const btn = document.getElementById('shuffleBtn');
    if (isShuffled) {
      btn.classList.add('text-secondary-fixed');
      btn.classList.add('bg-surface-container-highest/20');
    } else {
      btn.classList.remove('text-secondary-fixed');
      btn.classList.remove('bg-surface-container-highest/20');
    }
  }

  function toggleAutoplay() {
    isAutoplay = !isAutoplay;
    const btn = document.getElementById('autoplayToggle');
    if (isAutoplay) {
      btn.classList.add('text-secondary-fixed');
      btn.classList.add('bg-surface-container-highest/20');
    } else {
      btn.classList.remove('text-secondary-fixed');
      btn.classList.remove('bg-surface-container-highest/20');
    }
  }

  function skipTime(seconds) {
    const timeDisplay = document.getElementById('playerCurrentTime');
    let [min, sec] = timeDisplay.textContent.split(':').map(Number);
    let totalSec = Math.max(0, min * 60 + sec + seconds);
    let newMin = Math.floor(totalSec / 60).toString().padStart(2, '0');
    let newSec = (totalSec % 60).toString().padStart(2, '0');
    timeDisplay.textContent = `${newMin}:${newSec}`;
  }

  function toggleSleepTimer() {
    const label = document.getElementById('sleepTimerLabel');
    const durations = ['15m', '30m', '45m', '60m', 'Off'];
    let currentIdx = durations.indexOf(label.textContent);
    let nextIdx = (currentIdx + 1) % durations.length;
    label.textContent = durations[nextIdx];
  }

  function cycleSort() {
    sortIndex = (sortIndex + 1) % sortOptions.length;
    const btn = document.getElementById('sortOrderLabel');
    btn.querySelector('span').textContent = sortOptions[sortIndex];
  }

  function setFilter(el, category) {
    const siblings = el.parentElement.querySelectorAll('button');
    siblings.forEach(sib => {
      sib.classList.remove('bg-primary', 'text-on-primary', 'font-semibold');
      sib.classList.add('bg-surface-container', 'text-on-surface-variant');
    });
    el.classList.remove('bg-surface-container', 'text-on-surface-variant');
    el.classList.add('bg-primary', 'text-on-primary', 'font-semibold');
  }

  function playSnippet(btn, ayahRef) {
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon.textContent === 'play_circle') {
      icon.textContent = 'pause_circle';
      btn.classList.add('bg-secondary');
      btn.classList.add('text-on-secondary');
    } else {
      icon.textContent = 'play_circle';
      btn.classList.remove('bg-secondary');
      btn.classList.remove('text-on-secondary');
    }
  }

  function scrubPlayback(e) {
    const bar = document.getElementById('waveformBar');
    const rect = bar.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const percent = Math.min(Math.max(clickX / rect.width, 0), 1);
    const totalSec = 24 * 60 + 18;
    const currentSec = Math.floor(percent * totalSec);
    const m = Math.floor(currentSec / 60).toString().padStart(2, '0');
    const s = (currentSec % 60).toString().padStart(2, '0');
    document.getElementById('playerCurrentTime').textContent = `${m}:${s}`;
  }

  function shareTopic() {
    if (navigator.share) {
      navigator.share({
        title: 'Sabr & Steadfastness on Noor Recite',
        text: 'Explore this curated collection of 103 Ayahs on Patience & Steadfastness in the Quran.',
        url: window.location.href,
      }).catch(() => {});
    }
  }

  function shareAyah(ref) {
    if (navigator.share) {
      navigator.share({
        title: `Quran Ayah ${ref}`,
        text: `Contemplate ${ref} on Noor Recite: Steadfastness & Divine Guidance.`,
        url: window.location.href,
      }).catch(() => {});
    }
  }

  function downloadPlaylist() {
    alert("Audio playlist 'Sabr & Steadfastness' (Sheikh Saad Al-Ghamdi) queued for offline recitation.");
  }

