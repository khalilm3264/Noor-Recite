  function selectDrillOption(buttonEl, isCorrect, sourceRef) {
    const feedbackBox = document.getElementById('drill-feedback');
    const container = document.getElementById('drill-options');
    
    // Reset all buttons visual state
    const allButtons = container.querySelectorAll('button');
    allButtons.forEach(btn => {
