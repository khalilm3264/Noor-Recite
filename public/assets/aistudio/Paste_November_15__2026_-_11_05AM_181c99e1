  // Noor Recite Search & Bookmark Hub Interactivity
  (function initSearchAndBookmarks() {
    const searchInput = document.getElementById('quran-search-input');
    const searchClearBtn = document.getElementById('search-clear-btn');
    const emptyState = document.getElementById('search-empty-state');
    const resetSearchBtn = document.getElementById('reset-search-btn');
    const clearRecentsBtn = document.getElementById('clear-recents-btn');
    const quickJumpContainer = document.getElementById('quick-jump-container');

    const viewSaved = document.getElementById('view-saved-ayahs');
    const viewCollections = document.getElementById('view-collections');
    const viewTajweed = document.getElementById('view-tajweed');
    const ayahCards = document.querySelectorAll('.ayah-card');
    const navTabs = document.querySelectorAll('.nav-tab');
    const filterChips = document.querySelectorAll('.filter-chip');
    const playButtons = document.querySelectorAll('.play-snippet-btn');
    const resumeBannerBtn = document.getElementById('resume-banner-btn');

    // 1. Live Search & Keyword Filtering
    function filterAyahs(query) {
      const q = query.toLowerCase().trim();
      let matchedCount = 0;

      if (q.length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }

      ayahCards.forEach(card => {
        const keywords = card.getAttribute('data-keywords') || '';
        const textContent = card.innerText.toLowerCase();
        if (keywords.toLowerCase().includes(q) || textContent.includes(q)) {
          card.classList.remove('hidden');
          matchedCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (matchedCount === 0 && viewSaved && !viewSaved.classList.contains('hidden')) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
      } else {
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => filterAyahs(e.target.value));
    }

    if (searchClearBtn) {
      searchClearBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterAyahs('');
        searchInput.focus();
      });
    }

    if (resetSearchBtn) {
      resetSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        filterAyahs('');
      });
    }

    // 2. Quick Jump pill clicks
    document.querySelectorAll('.quick-tag').forEach(tag => {
      tag.addEventListener('click', () => {
        const query = tag.getAttribute('data-query');
        if (searchInput) {
          searchInput.value = query;
          filterAyahs(query);
        }
      });
    });

    if (clearRecentsBtn && quickJumpContainer) {
      clearRecentsBtn.addEventListener('click', () => {
        quickJumpContainer.innerHTML = '<span class="font-label-sm text-label-sm text-outline italic px-2">Recents cleared</span>';
        clearRecentsBtn.classList.add('hidden');
      });
    }

    // 3. Sub-Navigation Tabs Switching
    navTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        navTabs.forEach(t => {
          t.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
          t.classList.add('text-on-surface-variant');
        });
        tab.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
        tab.classList.remove('text-on-surface-variant');

        const tabKey = tab.getAttribute('data-tab');
        if (viewSaved) viewSaved.classList.add('hidden');
        if (viewCollections) viewCollections.classList.add('hidden');
        if (viewTajweed) viewTajweed.classList.add('hidden');
        emptyState.classList.add('hidden');

        if (tabKey === 'saved' && viewSaved) {
          viewSaved.classList.remove('hidden');
          filterAyahs(searchInput ? searchInput.value : '');
        } else if (tabKey === 'collections' && viewCollections) {
          viewCollections.classList.remove('hidden');
        } else if (tabKey === 'tajweed' && viewTajweed) {
          viewTajweed.classList.remove('hidden');
        }
      });
    });

    // 4. Quick Category Filters
    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        filterChips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          c.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
        });
        chip.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
        chip.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');

        const category = chip.getAttribute('data-filter');
        if (category === 'all') {
          filterAyahs('');
        } else if (category === 'bookmarks') {
          filterAyahs('protection');
        } else if (category === 'audio') {
          filterAyahs('snippet');
        } else if (category === 'topics') {
          filterAyahs('sabr');
        }
      });
    });

    // 5. Playback Snippet Button Interactive Toggle
    let currentPlayingBtn = null;
    playButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const iconSpan = btn.querySelector('.material-symbols-outlined');
        if (!iconSpan) return;

        if (currentPlayingBtn && currentPlayingBtn !== btn) {
          const prevIcon = currentPlayingBtn.querySelector('.material-symbols-outlined');
          if (prevIcon) prevIcon.textContent = 'play_arrow';
          currentPlayingBtn.classList.remove('bg-secondary');
          currentPlayingBtn.classList.add('bg-primary');
        }

        if (iconSpan.textContent === 'play_arrow') {
          iconSpan.textContent = 'pause';
          btn.classList.remove('bg-primary');
          btn.classList.add('bg-secondary');
          currentPlayingBtn = btn;
        } else {
          iconSpan.textContent = 'play_arrow';
          btn.classList.remove('bg-secondary');
          btn.classList.add('bg-primary');
          currentPlayingBtn = null;
        }
      });
    });

    // 6. Resume banner interaction
    if (resumeBannerBtn) {
      resumeBannerBtn.addEventListener('click', () => {
        const icon = resumeBannerBtn.querySelector('.material-symbols-outlined');
        const text = resumeBannerBtn.querySelector('span:not(.material-symbols-outlined)');
        if (icon && text) {
          if (icon.textContent === 'play_arrow') {
            icon.textContent = 'pause';
            text.textContent = 'Playing...';
            resumeBannerBtn.classList.replace('bg-secondary', 'bg-secondary-container');
          } else {
            icon.textContent = 'play_arrow';
            text.textContent = 'Resume';
            resumeBannerBtn.classList.replace('bg-secondary-container', 'bg-secondary');
          }
        }
      });
    }
  })();
