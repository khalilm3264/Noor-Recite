<script>
  // Noor Recite Audio Engine & Synchronizer Simulation with Real-time Interactive Waveform Scrubbing
  (function() {
    // --- Web Audio API Harmonizer ---
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playSoothingChime(frequency = 329.63, duration = 0.6, type = 'sine') {
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;
        
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(frequency, now);

        const overtone = ctx.createOscillator();
        const overtoneGain = ctx.createGain();
        overtone.type = 'triangle';
        overtone.frequency.setValueAtTime(frequency * 1.5, now);

        gain.gain.setValueAtTime(0.001, now);
        gain.gain.exponentialRampToValueAtTime(0.18, now + 0.06);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        overtoneGain.gain.setValueAtTime(0.001, now);
        overtoneGain.gain.exponentialRampToValueAtTime(0.05, now + 0.04);
        overtoneGain.gain.exponentialRampToValueAtTime(0.0001, now + (duration * 0.7));

        osc.connect(gain);
        overtone.connect(overtoneGain);
        gain.connect(ctx.destination);
        overtoneGain.connect(ctx.destination);

        osc.start(now);
        overtone.start(now);
        osc.stop(now + duration + 0.05);
        overtone.stop(now + duration + 0.05);
      } catch (e) {
        console.warn('Web Audio note unable to play:', e);
      }
    }

    // Audio State
    let isPlaying = true;
    let playbackSpeed = 1.0;
    const totalDurationSec = 42.0; // Surah Al-Fatihah Ayah 2 timeline 0:00 - 0:42
    let currentSec = 14.0; // Starts playing Word 2
    let repeatModeIdx = 0; // 0 = WORD, 1 = AYAH, 2 = SURAH
    let isAyahLoopActive = false;
    let isScrubbing = false;

    // Word Timestamps calibrated strictly across 0:00 to 0:42:
    // Word 1 (0:00 - 0:10): 'al-hamdu'
    // Word 2 (0:11 - 0:21): 'lillāhi'
    // Word 3 (0:22 - 0:31): 'rabbi'
    // Word 4 (0:32 - 0:42): 'al-ʿālamīn'
    const wordsData = [
      {
        idx: 0,
        arabic: "ٱلْحَمْدُ",
        phonetic: "al-ḥamdu",
        meaning: "[All] praise",
        start: 0.0,
        end: 10.5,
        freq: 261.63, // C4
        rule: null
      },
      {
        idx: 1,
        arabic: "لِلَّهِ",
        phonetic: "lil-lāh",
        meaning: "to Allah",
        start: 10.5,
        end: 21.5,
        freq: 329.63, // E4
        rule: "tarqiq"
      },
      {
        idx: 2,
        arabic: "رَبِّ",
        phonetic: "rabbi",
        meaning: "Lord",
        start: 21.5,
        end: 31.5,
        freq: 392.00, // G4
        rule: null
      },
      {
        idx: 3,
        arabic: "ٱلْعَـٰلَمِينَ ۝٢",
        phonetic: "al-ʿālamīn",
        meaning: "of the worlds",
        start: 31.5,
        end: 42.0,
        freq: 440.00, // A4
        rule: "madd"
      }
    ];

    let currentWordIndex = 1;

    // Build Waveform Bars in Scrubber Container
    const barsContainer = document.getElementById('bars-container');
    const barCount = 28;
    const baseAmplitudes = [
      18, 24, 34, 42, 28, 38, 48, 52, 36, 44, 50, 42, 32, 26,
      30, 46, 54, 48, 38, 44, 52, 40, 32, 26, 36, 48, 42, 22
    ];

    if (barsContainer) {
      barsContainer.innerHTML = '';
      for (let i = 0; i < barCount; i++) {
        const bar = document.createElement('div');
        bar.className = 'w-2 rounded-full transition-all duration-100 flex-1 max-w-[8px] waveform-bar bg-surface-container-high';
        bar.setAttribute('data-bar-idx', i);
        bar.style.height = `${baseAmplitudes[i % baseAmplitudes.length]}px`;
        barsContainer.appendChild(bar);
      }
    }
    const waveformBars = document.querySelectorAll('.waveform-bar');

    // DOM Elements
    const playBtn = document.getElementById('btn-main-play');
    const playIcon = document.getElementById('play-icon');
    const timestampEl = document.getElementById('current-timestamp');
    const playheadBar = document.getElementById('playhead-bar');
    const scrubTooltip = document.getElementById('scrub-tooltip');
    const tooltipTime = document.getElementById('tooltip-time');
    const tooltipWord = document.getElementById('tooltip-word');
    const wordCards = document.querySelectorAll('.word-card');
    const activeWordLabel = document.getElementById('active-word-label');
    const recitationStatusText = document.getElementById('recitation-status-text');
    const liveEqContainer = document.getElementById('live-eq-container');
    const speedBtn = document.getElementById('btn-speed-toggle');
    const repeatBtn = document.getElementById('btn-repeat-mode');
    const repeatIcon = document.getElementById('repeat-icon');
    const repeatLabel = document.getElementById('repeat-label');
    const btnNextWord = document.getElementById('btn-next-word');
    const btnLoopAyah = document.getElementById('btn-loop-ayah');
    const loopAyahIcon = document.getElementById('loop-ayah-icon');
    const rewindBtn = document.getElementById('btn-rewind-10');
    const forwardBtn = document.getElementById('btn-forward-10');
    const scrubber = document.getElementById('waveform-scrubber');
    const transWords = document.querySelectorAll('.trans-word');
    const transMeanings = document.querySelectorAll('.trans-meaning');
    const headerStatusText = document.getElementById('header-status-text');
    const headerPulse = document.getElementById('header-pulse');

    // Tooltip Drawer Tabs
    const tajweedDrawer = document.getElementById('tajweed-tooltip-drawer');
    const tabTarqiq = document.getElementById('tajweed-tooltip-tarqiq');
    const tabMadd = document.getElementById('tajweed-tooltip-madd');
    const headerRuleTitle = document.getElementById('rule-guide-header-title');

    window.showRuleTarqiq = function() {
      if (tajweedDrawer) tajweedDrawer.classList.remove('hidden');
      if (tabTarqiq) tabTarqiq.classList.remove('hidden');
      if (tabMadd) tabMadd.classList.add('hidden');
      if (headerRuleTitle) headerRuleTitle.textContent = "Tajweed: Tarqīq al-Lām (لِلَّهِ)";
    };

    window.showRuleMadd = function() {
      if (tajweedDrawer) tajweedDrawer.classList.remove('hidden');
      if (tabTarqiq) tabTarqiq.classList.add('hidden');
      if (tabMadd) tabMadd.classList.remove('hidden');
      if (headerRuleTitle) headerRuleTitle.textContent = "Tajweed: Madd 'Āriḍ (ٱلْعَـٰلَمِينَ)";
    };

    function formatTime(seconds) {
      const s = Math.max(0, Math.min(totalDurationSec, seconds));
      const min = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${min}:${sec < 10 ? '0' : ''}${sec}`;
    }

    function getWordIndexForTime(sec) {
      for (let i = 0; i < wordsData.length; i++) {
        if (sec >= wordsData[i].start && sec < wordsData[i].end) {
          return i;
        }
      }
      return wordsData.length - 1;
    }

    // Set Active Word UI
    function setActiveWord(index, triggerSound = true) {
      if (index < 0 || index >= wordsData.length) return;
      currentWordIndex = index;
      const word = wordsData[index];

      // Update Word Cards DOM
      wordCards.forEach((card, i) => {
        const bubble = card.querySelector('.word-bubble');
        const phone = card.querySelector('.phonetic-badge');
        const mean = card.querySelector('.meaning-badge');
        const existingMicro = bubble ? bubble.querySelector('.microwaves') : null;
        const existingStatus = bubble ? bubble.querySelector('.status-icon') : null;

        if (!bubble) return;

        if (i === index) {
          // Highlight Active: glowing amber/emerald border & pill
          card.classList.remove('opacity-60', 'opacity-85');
          card.classList.add('-translate-y-1');
          bubble.className = "word-bubble relative px-3.5 py-2 rounded-xl border-2 border-secondary bg-gradient-to-r from-secondary-container/30 via-secondary/25 to-secondary-container/30 shadow-[0_6px_20px_rgba(254,147,44,0.45)] active-word-glow flex items-center gap-1.5";
          
          if (!existingMicro) {
            if (existingStatus) existingStatus.remove();
            const microDiv = document.createElement('div');
            microDiv.className = 'microwaves flex items-center gap-0.5 h-4 ml-0.5';
            microDiv.innerHTML = '<span class="w-0.5 h-2.5 bg-secondary rounded-full animate-pulse"></span><span class="w-0.5 h-4 bg-secondary rounded-full animate-bounce"></span><span class="w-0.5 h-2 bg-secondary rounded-full animate-pulse"></span>';
            bubble.prepend(microDiv);
          }
          if (phone) {
            phone.className = "phonetic-badge font-label-md text-label-md font-bold text-secondary bg-secondary/15 px-2.5 py-0.5 rounded-full shadow-sm";
          }
          if (mean) {
            mean.className = "meaning-badge text-[11px] font-bold text-primary mt-0.5";
          }
        } else if (i < index) {
          // Already Recited
          card.classList.remove('-translate-y-1');
          card.classList.add('opacity-85');
          bubble.className = "word-bubble px-3 py-1.5 rounded-xl border-2 border-transparent bg-surface-container-high/40 text-primary hover:bg-surface-container-high transition-all flex items-center gap-1.5";
          if (existingMicro) existingMicro.remove();
          if (!existingStatus) {
            const check = document.createElement('span');
            check.className = 'status-icon material-symbols-outlined text-secondary text-[14px]';
            check.style.fontVariationSettings = "'FILL' 1";
            check.textContent = 'check_circle';
            bubble.appendChild(check);
          }
          if (phone) phone.className = "phonetic-badge font-label-sm text-label-sm text-outline-variant font-medium";
          if (mean) mean.className = "meaning-badge text-[10px] text-on-surface-variant";
        } else {
          // Upcoming Word
          card.classList.remove('-translate-y-1');
          card.classList.add('opacity-70');
          bubble.className = "word-bubble px-3 py-1.5 rounded-xl border-2 border-transparent bg-surface-container/60 hover:bg-surface-container-high transition-all flex items-center gap-1.5";
          if (existingMicro) existingMicro.remove();
          if (existingStatus) existingStatus.remove();
          if (phone) phone.className = "phonetic-badge font-label-sm text-label-sm text-on-surface-variant font-medium";
          if (mean) mean.className = "meaning-badge text-[10px] text-outline";
        }
      });

      // Transliteration & Translation sync
      transWords.forEach((tw, i) => {
        if (i === index) {
          tw.className = "trans-word text-secondary font-bold underline decoration-secondary-container decoration-2 underline-offset-2 cursor-pointer";
        } else {
          tw.className = "trans-word text-primary font-medium cursor-pointer hover:underline";
        }
      });

      transMeanings.forEach((tm, i) => {
        if (i === index) {
          tm.className = "trans-meaning text-secondary font-bold cursor-pointer";
        } else {
          tm.className = "trans-meaning text-on-surface cursor-pointer";
        }
      });

      if (activeWordLabel) {
        activeWordLabel.textContent = `Word ${index + 1} ("${word.arabic.replace(' ۝٢', '')}")`;
      }
      const subPractice = document.getElementById('practice-mode-subtext');
      if (subPractice) {
        subPractice.textContent = `Recite Word ${index + 1} ("${word.arabic.replace(' ۝٢', '')}") into mic for instant tajweed pitch analysis`;
      }

      // Synchronize Tajweed rule drawer view with active word
      if (word.rule === 'tarqiq') {
        window.showRuleTarqiq();
      } else if (word.rule === 'madd') {
        window.showRuleMadd();
      }

      if (triggerSound) {
        playSoothingChime(word.freq, 0.45, 'sine');
      }
    }

    // Update Playhead & Waveform Colors
    function updatePlayheadUI(ratio) {
      const clampedRatio = Math.max(0, Math.min(1, ratio));
      const percentage = (clampedRatio * 100).toFixed(1);

      if (playheadBar) {
        playheadBar.style.left = `${percentage}%`;
      }
      if (scrubTooltip) {
        scrubTooltip.style.left = `${percentage}%`;
        if (tooltipTime) tooltipTime.textContent = formatTime(clampedRatio * totalDurationSec);
        const activeW = wordsData[getWordIndexForTime(clampedRatio * totalDurationSec)];
        if (tooltipWord && activeW) tooltipWord.textContent = activeW.arabic.replace(' ۝٢', '');
      }

      const activeBarIdx = Math.floor(clampedRatio * waveformBars.length);
      waveformBars.forEach((bar, idx) => {
        if (idx < activeBarIdx) {
          bar.classList.add('bg-secondary-container');
          bar.classList.remove('bg-surface-container-high', 'bg-secondary');
        } else if (idx === activeBarIdx) {
          bar.classList.add('bg-secondary');
          bar.classList.remove('bg-surface-container-high', 'bg-secondary-container');
        } else {
          bar.classList.add('bg-surface-container-high');
          bar.classList.remove('bg-secondary-container', 'bg-secondary');
        }
      });
    }

    // Apply scrub position from ratio
    function applyScrub(ratio, playSound = false) {
      const clampedRatio = Math.max(0, Math.min(1, ratio));
      currentSec = clampedRatio * totalDurationSec;
      if (timestampEl) timestampEl.textContent = formatTime(currentSec);

      updatePlayheadUI(clampedRatio);

      const targetWordIdx = getWordIndexForTime(currentSec);
      if (targetWordIdx !== currentWordIndex) {
        setActiveWord(targetWordIdx, playSound);
      }
    }

    window.seekToRatio = function(ratio) {
      applyScrub(ratio, true);
    };

    // --- Interactive Touch & Pointer Scrubbing Engine ---
    function handlePointerScrub(e) {
      if (!scrubber) return;
      const rect = scrubber.getBoundingClientRect();
      const clientX = e.clientX ?? (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      applyScrub(ratio, false);
    }

    if (scrubber) {
      scrubber.addEventListener('pointerdown', (e) => {
        isScrubbing = true;
        scrubber.setPointerCapture(e.pointerId);
        if (scrubTooltip) scrubTooltip.classList.remove('opacity-0');
        handlePointerScrub(e);
        playSoothingChime(311.13, 0.2);
      });

      scrubber.addEventListener('pointermove', (e) => {
        if (isScrubbing) {
          handlePointerScrub(e);
        }
      });

      const endScrub = (e) => {
        if (isScrubbing) {
          isScrubbing = false;
          try { scrubber.releasePointerCapture(e.pointerId); } catch (_) {}
          if (scrubTooltip) scrubTooltip.classList.add('opacity-0');
          // Play chime confirmation for landed word
          const activeW = wordsData[currentWordIndex];
          if (activeW) playSoothingChime(activeW.freq, 0.4);
        }
      };

      scrubber.addEventListener('pointerup', endScrub);
      scrubber.addEventListener('pointercancel', endScrub);
    }

    // Direct Arabic Word Card Tapping (Jumps playhead & plays immediately)
    wordCards.forEach((card) => {
      card.addEventListener('click', function() {
        const wIdx = parseInt(this.getAttribute('data-word-idx'), 10);
        if (!isNaN(wIdx) && wordsData[wIdx]) {
          const targetTime = wordsData[wIdx].start + 0.1;
          applyScrub(targetTime / totalDurationSec, true);
          if (!isPlaying && playBtn) {
            playBtn.click();
          }
        }
      });
    });

    // Transliteration text word click jump
    transWords.forEach((tw) => {
      tw.addEventListener('click', function() {
        const wIdx = parseInt(this.getAttribute('data-word-idx'), 10);
        if (!isNaN(wIdx) && wordsData[wIdx]) {
          applyScrub((wordsData[wIdx].start + 0.1) / totalDurationSec, true);
        }
      });
    });

    // Translation text word click jump
    transMeanings.forEach((tm) => {
      tm.addEventListener('click', function() {
        const wIdx = parseInt(this.getAttribute('data-word-idx'), 10);
        if (!isNaN(wIdx) && wordsData[wIdx]) {
          applyScrub((wordsData[wIdx].start + 0.1) / totalDurationSec, true);
        }
      });
    });

    // Visualizer Dynamic Sine Animation when reciter is active
    function updateVisualizer(now) {
      if (!isPlaying || isScrubbing) return;
      waveformBars.forEach((bar, idx) => {
        const speedFactor = (idx * 0.38) + (now * 0.007);
        const dynamicH = Math.sin(speedFactor) * 14 + (baseAmplitudes[idx % baseAmplitudes.length] * 0.7);
        bar.style.height = `${Math.max(10, Math.min(54, dynamicH))}px`;
      });
    }

    // Recitation Audio Frame Loop
    let lastTimestamp = performance.now();
    function audioLoop(timestamp) {
      const dt = (timestamp - lastTimestamp) / 1000;
      lastTimestamp = timestamp;

      if (isPlaying && !isScrubbing) {
        currentSec += dt * playbackSpeed;

        if (repeatModeIdx === 0) { // Repeat Word Mode
          const activeWord = wordsData[currentWordIndex];
          if (currentSec > activeWord.end) {
            currentSec = activeWord.start;
            playSoothingChime(activeWord.freq, 0.45);
          }
        } else if (repeatModeIdx === 1 || isAyahLoopActive) { // Loop Ayah 2 Mode
          if (currentSec >= totalDurationSec) {
            currentSec = 0.0;
            setActiveWord(0, true);
          }
        } else { // Continuous Surah mode
          if (currentSec >= totalDurationSec) {
            currentSec = 0.0;
          }
        }

        // Trigger active word changes during natural playback
        const targetWordIdx = getWordIndexForTime(currentSec);
        if (targetWordIdx !== currentWordIndex) {
          setActiveWord(targetWordIdx, true);
        }

        if (timestampEl) timestampEl.textContent = formatTime(currentSec);
        updatePlayheadUI(currentSec / totalDurationSec);
        updateVisualizer(timestamp);
      }

      requestAnimationFrame(audioLoop);
    }
    requestAnimationFrame(audioLoop);

    // Play/Pause button toggle
    if (playBtn && playIcon) {
      playBtn.addEventListener('click', function() {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playIcon.textContent = 'pause';
          playBtn.classList.remove('opacity-90', 'scale-95');
          if (recitationStatusText) recitationStatusText.textContent = "Live Audio Playing (Sheikh Saad Al-Ghamdi - Tartil)";
          if (liveEqContainer) liveEqContainer.classList.remove('opacity-40');
          if (headerPulse) headerPulse.classList.add('animate-pulse');
          if (headerStatusText) headerStatusText.textContent = "Surah Player • Reciting";
          playSoothingChime(329.63, 0.7, 'sine');
        } else {
          playIcon.textContent = 'play_arrow';
          playBtn.classList.add('opacity-90', 'scale-95');
          if (recitationStatusText) recitationStatusText.textContent = "Playback Paused (Tap Play to Resume)";
          if (liveEqContainer) liveEqContainer.classList.add('opacity-40');
          if (headerPulse) headerPulse.classList.remove('animate-pulse');
          if (headerStatusText) headerStatusText.textContent = "Surah Player • Paused";
        }
      });
    }

    // Next Word Button
    if (btnNextWord) {
      btnNextWord.addEventListener('click', function() {
        const nextIdx = (currentWordIndex + 1) % wordsData.length;
        applyScrub((wordsData[nextIdx].start + 0.1) / totalDurationSec, true);
      });
    }

    // Repeat Mode Cycler (WORD -> AYAH -> SURAH)
    const repeatModes = [
      { icon: 'repeat_one', label: 'WORD' },
      { icon: 'repeat', label: 'AYAH' },
      { icon: 'all_inclusive', label: 'SURAH' }
    ];

    if (repeatBtn && repeatIcon && repeatLabel) {
      repeatBtn.addEventListener('click', function() {
        repeatModeIdx = (repeatModeIdx + 1) % repeatModes.length;
        repeatIcon.textContent = repeatModes[repeatModeIdx].icon;
        repeatLabel.textContent = repeatModes[repeatModeIdx].label;
        const loopIndicator = document.getElementById('loop-indicator-icon');
        if (loopIndicator) loopIndicator.textContent = repeatModes[repeatModeIdx].icon;
        playSoothingChime(392.00, 0.3);
      });
    }

    // Rewind / Forward 10s
    if (rewindBtn) {
      rewindBtn.addEventListener('click', function() {
        applyScrub(Math.max(0, currentSec - 10) / totalDurationSec, true);
      });
    }
    if (forwardBtn) {
      forwardBtn.addEventListener('click', function() {
        applyScrub(Math.min(totalDurationSec - 0.2, currentSec + 10) / totalDurationSec, true);
      });
    }

    // Speed toggle
    const speeds = ['1.0x', '1.25x', '1.5x', '0.75x'];
    let speedIdx = 0;
    if (speedBtn) {
      speedBtn.addEventListener('click', function() {
        speedIdx = (speedIdx + 1) % speeds.length;
        playbackSpeed = parseFloat(speeds[speedIdx]);
        speedBtn.textContent = speeds[speedIdx];
        playSoothingChime(349.23, 0.25);
      });
    }

    // Loop Ayah Action
    if (btnLoopAyah && loopAyahIcon) {
      btnLoopAyah.addEventListener('click', function() {
        isAyahLoopActive = !isAyahLoopActive;
        if (isAyahLoopActive) {
          btnLoopAyah.classList.add('text-secondary', 'font-bold');
          loopAyahIcon.style.fontVariationSettings = "'FILL' 1";
          playSoothingChime(440, 0.3);
        } else {
          btnLoopAyah.classList.remove('text-secondary', 'font-bold');
          loopAyahIcon.style.fontVariationSettings = "'FILL' 0";
        }
      });
    }

    // Listen Rule Audio Button
    const btnListenRuleAudio = document.getElementById('btn-listen-rule-audio');
    if (btnListenRuleAudio) {
      btnListenRuleAudio.addEventListener('click', function() {
        playSoothingChime(currentWordIndex === 3 ? 440 : 329.63, 0.7, 'sine');
        this.classList.add('bg-secondary', 'text-on-secondary');
        setTimeout(() => {
          this.classList.remove('bg-secondary', 'text-on-secondary');
        }, 500);
      });
    }

    // Tafsir drawer toggle
    const toggleTafsirBtn = document.getElementById('toggle-tafsir');
    const sheetTafsirBtn = document.getElementById('btn-tafsir-sheet');
    const tafsirDrawer = document.getElementById('tafsir-drawer');
    const closeTafsirBtn = document.getElementById('close-tafsir');

    function openTafsir() {
      if (tafsirDrawer) {
        tafsirDrawer.classList.remove('hidden');
        tafsirDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    if (toggleTafsirBtn) toggleTafsirBtn.addEventListener('click', openTafsir);
    if (sheetTafsirBtn) sheetTafsirBtn.addEventListener('click', openTafsir);
    if (closeTafsirBtn && tafsirDrawer) {
      closeTafsirBtn.addEventListener('click', function() {
        tafsirDrawer.classList.add('hidden');
      });
    }

    // Ayah track chip direct select
    const ayahChips = document.querySelectorAll('.ayah-chip');
    ayahChips.forEach(chip => {
      chip.addEventListener('click', function() {
        const startSec = parseFloat(this.getAttribute('data-start') || '0');
        applyScrub(Math.min(0.99, startSec / totalDurationSec), true);
      });
    });

    // Practice Recitation Button feedback
    const btnTest = document.getElementById('btn-test-recitation');
    if (btnTest) {
      btnTest.addEventListener('click', function() {
        playSoothingChime(523.25, 0.6, 'sine');
        const origText = btnTest.textContent;
        btnTest.textContent = 'Listening...';
        btnTest.classList.add('bg-primary');
        setTimeout(() => {
          btnTest.textContent = 'Tajweed 98% Correct!';
          btnTest.classList.remove('bg-primary');
          btnTest.classList.add('bg-emerald-600');
          setTimeout(() => {
            btnTest.textContent = origText;
            btnTest.classList.remove('bg-emerald-600');
          }, 2400);
        }, 1600);
      });
    }

    // Initial setup with Word 2 active (0:14)
    applyScrub(14.0 / totalDurationSec, false);
    setActiveWord(1, false);
  })();
