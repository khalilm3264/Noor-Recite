<script>
  (function() {
    // Interactive Tab Toggling between Hafs and Warsh Audio
    const toggleHafs = document.getElementById('toggle-hafs');
    const toggleWarsh = document.getElementById('toggle-warsh');
    const cardHafs = document.getElementById('card-hafs');
    const cardWarsh = document.getElementById('card-warsh');
    const masterPlayBtn = document.getElementById('master-play-btn');
    const audioTimeCurrent = document.getElementById('audio-time-current');
    
    let isPlaying = false;
    let activeRiwayah = 'hafs';

    function setRiwayah(type) {
      activeRiwayah = type;
      if (type === 'hafs') {
        toggleHafs.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
        toggleHafs.classList.remove('bg-transparent', 'text-on-surface-variant');
        toggleWarsh.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');
        toggleWarsh.classList.add('bg-transparent', 'text-on-surface-variant');
        
        cardHafs.classList.add('ring-2', 'ring-primary');
        cardWarsh.classList.remove('ring-2', 'ring-secondary');
      } else {
        toggleWarsh.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');
        toggleWarsh.classList.remove('bg-transparent', 'text-on-surface-variant');
        toggleHafs.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
        toggleHafs.classList.add('bg-transparent', 'text-on-surface-variant');
        
        cardWarsh.classList.add('ring-2', 'ring-secondary');
        cardHafs.classList.remove('ring-2', 'ring-primary');
      }
    }

    if (toggleHafs && toggleWarsh) {
      toggleHafs.addEventListener('click', () => setRiwayah('hafs'));
      toggleWarsh.addEventListener('click', () => setRiwayah('warsh'));
    }

    // Playback state toggle micro-interaction
    if (masterPlayBtn) {
      masterPlayBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        const icon = masterPlayBtn.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.textContent = isPlaying ? 'pause' : 'play_arrow';
        }
        if (isPlaying) {
          audioTimeCurrent.textContent = '0:02.1';
        } else {
          audioTimeCurrent.textContent = '0:01.4';
        }
      });
    }

    // Sanad Modal Dialog interactions
    const sanadTrigger = document.getElementById('sanad-sheet-btn');
    const infoTrigger = document.getElementById('info-modal-trigger');
    const sanadModal = document.getElementById('sanad-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');

    function openModal() {
      if (sanadModal) sanadModal.classList.remove('hidden');
    }
    function closeModal() {
      if (sanadModal) sanadModal.classList.add('hidden');
    }

    if (sanadTrigger) sanadTrigger.addEventListener('click', openModal);
    if (infoTrigger) infoTrigger.addEventListener('click', openModal);
    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    if (sanadModal) {
      sanadModal.addEventListener('click', (e) => {
        if (e.target === sanadModal) closeModal();
      });
    }

    // Recording feedback simulation button
    const recordBtn = document.getElementById('record-practice-btn');
    if (recordBtn) {
      recordBtn.addEventListener('click', () => {
        const textSpan = recordBtn.querySelector('span:not(.material-symbols-outlined)');
        if (textSpan.textContent === 'Listening...') {
          textSpan.textContent = 'Matched: 98% Warsh Tartīl!';
          setTimeout(() => { textSpan.textContent = 'Record Ayah 4'; }, 2500);
        } else {
          textSpan.textContent = 'Listening...';
        }
      });
